<!doctype html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:; form-action 'none'; base-uri 'none'">
<meta name="referrer" content="no-referrer">
<meta name="robots" content="noindex">
<title>{{index .T "report.title"}}</title>
<style>
:root {
  color-scheme: light dark;
  --surface: #fcfcfb;
  --raised: #ffffff;
  --ink: #0b0b0b;
  --ink-2: #52514e;
  --muted: #898781;
  --grid: #e1e0d9;
  --baseline: #c3c2b7;
  --series-1: #2a78d6;
  --series-2: #eb6834;
  --series-3: #1baf7a;
  --series-4: #8a63d2;
  --good: #1a7f4e;
  --warn: #a35a00;
  --bad: #b3261e;
}
@media (prefers-color-scheme: dark) {
  :root:where(:not([data-theme="light"])) {
    --surface: #1a1a19;
    --raised: #222221;
    --ink: #f0efec;
    --ink-2: #c3c2b7;
    --muted: #898781;
    --grid: #2c2c2a;
    --baseline: #383835;
    --series-1: #3987e5;
    --series-2: #d95926;
    --series-3: #199e70;
    --series-4: #9b7be0;
    --good: #5cc48e;
    --warn: #e0a24a;
    --bad: #f08a80;
  }
}
:root[data-theme="dark"] {
  --surface: #1a1a19;
  --raised: #222221;
  --ink: #f0efec;
  --ink-2: #c3c2b7;
  --muted: #898781;
  --grid: #2c2c2a;
  --baseline: #383835;
  --series-1: #3987e5;
  --series-2: #d95926;
  --series-3: #199e70;
  --series-4: #9b7be0;
  --good: #5cc48e;
  --warn: #e0a24a;
  --bad: #f08a80;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--surface);
  color: var(--ink);
  font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
main { max-width: 760px; margin: 0 auto; padding: 32px 16px 48px; }
h1 { font-size: 28px; line-height: 1.2; margin: 0 0 4px; }
h2 { font-size: 20px; margin: 40px 0 8px; }
p { margin: 0 0 12px; }
.sub, .note, small { color: var(--ink-2); }
.note { font-size: 14px; }
[hidden] { display: none !important; }
.picker { display: flex; gap: 6px; overflow-x: auto; margin: 20px -16px 0; padding: 2px 16px 6px; scrollbar-width: none; }
.picker button { flex: none; font: inherit; font-size: 14px; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--grid); background: var(--raised); color: var(--ink); cursor: pointer; }
.picker button[aria-pressed="true"] { background: var(--ink); color: var(--surface); border-color: var(--ink); }
.month { margin-top: 24px; }
.when { color: var(--ink-2); margin: 0; }
.when .status { font-size: 14px; margin-left: 8px; }
.net { margin: 4px 0 0; display: flex; flex-direction: column; }
.net .label { font-size: 14px; color: var(--ink-2); }
.net .big { font-size: 44px; line-height: 1.1; font-weight: 700; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
.bar { display: flex; gap: 2px; height: 28px; margin: 12px 0 6px; }
.bar .seg { border: 0; padding: 0; min-width: 4px; cursor: pointer; }
.bar .seg:first-child { border-radius: 6px 0 0 6px; }
.bar .seg:last-child { border-radius: 0 6px 6px 0; }
.bar .seg:hover, .bar .seg:focus-visible { opacity: .8; }
.hint { font-size: 14px; color: var(--muted); margin: 0 0 8px; }
.part-net { --c: var(--series-1); } .part-contrib { --c: var(--series-2); } .part-taxes { --c: var(--series-3); } .part-other { --c: var(--series-4); }
.part-gross, .part-aside { --c: transparent; }
.bar .seg { background: var(--c); }
.parts { border-top: 1px solid var(--grid); }
.part { margin: 0; border-bottom: 1px solid var(--grid); }
.part > summary { display: flex; align-items: center; gap: 10px; padding: 12px 0; color: var(--ink); font-size: 16px; list-style: none; }
.part > summary::-webkit-details-marker { display: none; }
.part > summary .key { flex: none; width: 12px; height: 12px; border-radius: 3px; background: var(--c); border: 1px solid var(--c); }
.part-gross > summary .key, .part-aside > summary .key { border-color: var(--baseline); }
.part > summary .name { flex: 1; }
.part > summary .amount { font-variant-numeric: tabular-nums; font-weight: 600; }
.part > summary::after { content: "›"; color: var(--muted); transition: transform .15s; }
.part[open] > summary::after { transform: rotate(90deg); }
.part .body { padding: 0 0 12px 22px; }
.explain { font-size: 15px; color: var(--ink-2); margin: 0 0 8px; max-width: 70ch; }
.lines { list-style: none; padding: 0; margin: 0; }
.lines details { margin: 0; }
.lines summary { display: flex; gap: 12px; padding: 6px 0; color: var(--ink); font-size: 15px; }
.lines summary .desc { flex: 1; }
.lines summary .amount { font-variant-numeric: tabular-nums; white-space: nowrap; }
.lines summary { list-style: none; cursor: pointer; }
.lines summary::-webkit-details-marker { display: none; }
.lines summary::after { content: "›"; color: var(--muted); width: 8px; transition: transform .15s; }
.lines details[open] summary::after { transform: rotate(90deg); }
.lines .explain { font-size: 14px; padding: 0 0 6px; }
.more { margin-top: 32px; border-top: 1px solid var(--grid); }
.more > details { margin: 0; border-bottom: 1px solid var(--grid); }
.more > details > summary { padding: 14px 0; color: var(--ink); font-size: 16px; font-weight: 600; }
.more > details > :not(summary) { margin-bottom: 14px; }
figure { margin: 0; position: relative; }
.chart { width: 100%; height: auto; display: block; overflow: visible; }
.chart .grid { stroke: var(--grid); stroke-width: 1; }
.chart .baseline { stroke: var(--baseline); stroke-width: 1; }
.chart .tick { fill: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
.chart .end-label { fill: var(--ink-2); font-size: 12px; font-variant-numeric: tabular-nums; }
.chart .series-line { fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.chart .dot { stroke: var(--surface); stroke-width: 2; }
.chart .crosshair { stroke: var(--baseline); stroke-width: 1; }
.chart .seg { outline: none; }
.chart .seg:hover, .chart .seg:focus { opacity: .8; }
.legend { display: flex; flex-wrap: wrap; gap: 4px 16px; margin: 4px 0 8px; font-size: 14px; color: var(--ink-2); padding: 0; list-style: none; }
.legend .key { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: baseline; }
.legend .key.line { height: 2px; width: 14px; vertical-align: middle; border-radius: 1px; }
.tooltip {
  position: absolute; pointer-events: none; z-index: 1;
  background: var(--raised); color: var(--ink);
  border: 1px solid var(--grid); border-radius: 6px;
  padding: 6px 10px; font-size: 13px; white-space: nowrap;
  box-shadow: 0 2px 8px rgb(0 0 0 / .12);
}
.tooltip[hidden] { display: none; }
.tooltip .row { display: flex; align-items: center; gap: 6px; font-variant-numeric: tabular-nums; }
.tooltip .key { width: 8px; height: 8px; border-radius: 2px; }
.tooltip .head { color: var(--ink-2); }
details { margin-top: 8px; }
summary { cursor: pointer; color: var(--ink-2); font-size: 14px; }
.scroll { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 14px; }
th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--grid); vertical-align: top; }
th { color: var(--ink-2); font-weight: 600; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
.status { white-space: nowrap; }
.status::before { display: inline-block; width: 1.2em; font-weight: 700; }
.status.verified { color: var(--good); }
.status.verified::before { content: "✓"; }
.status.unverified { color: var(--warn); }
.status.unverified::before { content: "~"; }
.status.inconsistent { color: var(--bad); }
.status.inconsistent::before { content: "!"; }
.changes { margin: 0; padding-left: 20px; }
.changes > li { padding: 4px 0; }
.changes .why { color: var(--ink-2); font-size: 14px; }
.more-changes { margin-top: 4px; }
.more-changes > summary { font-size: 14px; color: var(--series-1); }
.contract-note { margin-top: 12px; }
.glossary { margin: 12px 0 0; }
.glossary dt { font-weight: 600; margin-top: 14px; }
.glossary dd { margin: 4px 0 0; font-size: 15px; color: var(--ink-2); max-width: 70ch; }
footer { margin-top: 32px; font-size: 13px; color: var(--muted); }
.embedded footer { display: none; }
.embedded main { padding-bottom: 8px; }
@media (max-width: 520px) {
  .chart .tick { font-size: 22px; }
  .chart .end-label { display: none; }
  .chart .tick.thin { display: none; }
}
@media print {
  .tooltip, .picker, .hint { display: none; }
  .month[hidden] { display: block !important; break-before: page; }
}
</style>
</head>
<body>
<main>
<header>
<h1>{{index .T "report.title"}}</h1>
{{with .Range}}<p class="sub">{{.}}</p>{{end}}
</header>

{{if gt (len .Months) 1}}
<nav class="picker" aria-label="{{index .T "report.pick"}}">
{{range $i, $m := .Months}}<button type="button" data-month="{{$i}}" aria-pressed="{{if eq $i $.Selected}}true{{else}}false{{end}}">{{$m.Short}}</button>
{{end}}</nav>
{{end}}

{{range $i, $m := .Months}}
<section class="month" data-month="{{$i}}"{{if ne $i $.Selected}} hidden{{end}}>
<p class="when">{{$m.Label}} <span class="status {{$m.Status}}">{{$m.StatusText}}</span></p>
<p class="net"><span class="label">{{index $.T "report.net"}}</span><span class="big">{{$m.Net}}</span></p>
{{if or $m.Gross $m.Delta}}<p class="sub">{{$m.Gross}}{{if and $m.Gross $m.Delta}} · {{end}}{{$m.Delta}}</p>{{end}}

{{if $m.Parts}}
<h2>{{index $.T "report.where"}}</h2>
<div class="bar">{{range $m.Parts}}<button type="button" class="seg part-{{.Key}}" style="width:{{printf "%.2f" .Width}}%" data-part="{{.Key}}" aria-label="{{.Label}} {{.Amount}}"></button>{{end}}</div>
<p class="hint">{{index $.T "report.tap"}}</p>
<div class="parts">
{{range $m.Parts}}<details class="part part-{{.Key}}" data-part="{{.Key}}">
<summary><span class="key"></span><span class="name">{{.Label}}</span><span class="amount">{{.Amount}}</span></summary>
<div class="body"><p class="explain">{{.Text}}</p>
{{if .Lines}}<ul class="lines">{{range .Lines}}{{template "line" .}}{{end}}</ul>{{end}}</div>
</details>
{{end}}{{if $m.Earnings}}<details class="part part-gross">
<summary><span class="key"></span><span class="name">{{index $.T "report.earnings"}}</span><span class="amount">{{$m.GrossTotal}}</span></summary>
<div class="body"><p class="explain">{{index $.T "report.earnings.text"}}</p>
<ul class="lines">{{range $m.Earnings}}{{template "line" .}}{{end}}</ul></div>
</details>
{{end}}{{if $m.SetAside}}<details class="part part-aside">
<summary><span class="key"></span><span class="name">{{index $.T "report.aside"}}</span><span class="amount">{{$m.AsideTotal}}</span></summary>
<div class="body"><p class="explain">{{index $.T "report.aside.text"}}</p>
<ul class="lines">{{range $m.SetAside}}{{template "line" .}}{{end}}</ul></div>
</details>
{{end}}</div>
{{end}}

{{if $m.Changes}}
<h2>{{index $.T "report.changes"}}</h2>
<ul class="changes">
{{range $m.Changes}}<li>{{.Text}}{{range .Why}}<div class="why">{{.}}</div>{{end}}</li>
{{end}}</ul>
{{if $m.More}}<details class="more-changes">
<summary>{{index $.T "report.all_changes"}} ({{len $m.More}})</summary>
<ul class="changes">
{{range $m.More}}<li>{{.Text}}{{range .Why}}<div class="why">{{.}}</div>{{end}}</li>
{{end}}</ul>
</details>{{end}}
{{end}}
</section>
{{end}}

{{if .Trend}}
<section>
<h2>{{index .T "report.trend"}}</h2>
<ul class="legend">
<li><span class="key line" style="background:var(--series-1)"></span>{{index .T "report.gross"}}</li>
<li><span class="key line" style="background:var(--series-2)"></span>{{index .T "report.net"}}</li>
</ul>
<figure>{{.Trend}}<div class="tooltip" hidden></div></figure>
</section>
{{end}}

{{if .Rows}}
<section class="more">
{{if gt (len .Rows) 1}}<details>
<summary>{{index .T "report.months"}}</summary>
<div class="scroll">
<table>
<thead><tr>
<th>{{index .T "report.col.period"}}</th>
<th class="num">{{index .T "report.gross"}}</th>
<th class="num">{{index .T "report.contrib"}}</th>
<th class="num">{{index .T "report.taxes"}}</th>
<th class="num">{{index .T "report.deductions"}}</th>
<th class="num">{{index .T "report.net"}}</th>
<th>{{index .T "report.col.status"}}</th>
</tr></thead>
<tbody>
{{range .Rows}}<tr>
<td>{{.Period}}</td>
<td class="num">{{.Gross}}</td>
<td class="num">{{.Contributions}}</td>
<td class="num">{{.Taxes}}</td>
<td class="num">{{.Deductions}}</td>
<td class="num">{{.Net}}</td>
<td><span class="status {{.Status}}">{{.StatusText}}</span></td>
</tr>
{{end}}</tbody>
</table>
</div>
</details>{{end}}

{{if .Leave}}<details>
<summary>{{index .T "report.leave"}}</summary>
<div class="scroll">
<table>
<thead><tr>
<th>{{index .T "report.col.kind"}}</th>
<th class="num">{{index .T "report.col.previous"}}</th>
<th class="num">{{index .T "report.col.accrued"}}</th>
<th class="num">{{index .T "report.col.used"}}</th>
<th class="num">{{index .T "report.col.remain"}}</th>
</tr></thead>
<tbody>
{{range .Leave}}<tr><td>{{.Label}}</td><td class="num">{{.Previous}}</td><td class="num">{{.Accrued}}</td><td class="num">{{.Used}}</td><td class="num">{{.Remaining}}</td></tr>
{{end}}</tbody>
</table>
</div>
</details>{{end}}

{{with .Contract}}<details>
<summary>{{index $.T "ccnl.section"}}</summary>
{{with .Title}}<p><strong>{{.}}</strong></p>{{end}}
{{with .Printed}}<p class="note">{{.}}</p>{{end}}
{{if .Rows}}<div class="scroll"><table>
<tbody>
{{range .Rows}}<tr><th scope="row">{{index . 0}}</th><td>{{index . 1}}</td></tr>
{{end}}</tbody>
</table></div>{{end}}
{{with .Note}}<p class="note contract-note">{{.}}</p>{{end}}
<p class="note">{{.Source}}</p>
</details>{{end}}

<details>
<summary>{{index .T "glossary.terms"}}</summary>
<dl class="glossary">
{{range .Terms}}<dt>{{.Label}}</dt>
<dd>{{.Text}}</dd>
{{end}}</dl>
</details>
</section>
{{end}}

<footer>
<p>{{index .T "report.privacy"}}</p>
<p>{{index .T "report.disclaimer"}}</p>
<p>{{index .T "report.generated"}}{{with .Version}} {{.}}{{end}}</p>
</footer>
</main>
<script>
(function () {
  function place(tip, fig, x, y) {
    var w = fig.clientWidth, tw = tip.offsetWidth;
    tip.style.left = Math.max(0, Math.min(w - tw, x + 12)) + "px";
    tip.style.top = Math.max(0, y - tip.offsetHeight - 8) + "px";
  }
  function row(color, name, value) {
    var r = document.createElement("div"); r.className = "row";
    var k = document.createElement("span"); k.className = "key"; k.style.background = color;
    var t = document.createElement("span"); t.textContent = name + ": " + value;
    r.appendChild(k); r.appendChild(t); return r;
  }
  function head(text) {
    var h = document.createElement("div"); h.className = "head"; h.textContent = text; return h;
  }
  document.querySelectorAll("svg.chart.line").forEach(function (svg) {
    var fig = svg.parentNode, tip = fig.querySelector(".tooltip");
    var xs = svg.dataset.x.split(",").map(Number), pts = JSON.parse(svg.dataset.points);
    var cross = svg.querySelector(".crosshair"), hit = svg.querySelector(".hit");
    function move(ev) {
      var pt = svg.createSVGPoint(); pt.x = ev.clientX; pt.y = ev.clientY;
      var p = pt.matrixTransform(svg.getScreenCTM().inverse());
      var best = 0;
      xs.forEach(function (x, i) { if (Math.abs(x - p.x) < Math.abs(xs[best] - p.x)) best = i; });
      cross.setAttribute("x1", xs[best]); cross.setAttribute("x2", xs[best]);
      cross.setAttribute("visibility", "visible");
      tip.replaceChildren(head(pts[best].label));
      pts[best].values.forEach(function (v) { tip.appendChild(row(v.color, v.name, v.value)); });
      tip.hidden = false;
      var box = fig.getBoundingClientRect();
      place(tip, fig, ev.clientX - box.left, ev.clientY - box.top);
    }
    hit.addEventListener("pointermove", move);
    hit.addEventListener("pointerleave", function () { tip.hidden = true; cross.setAttribute("visibility", "hidden"); });
  });
  // The month picker shows one payslip at a time. It opens on the latest
  // month, at the end of the row: scroll the row so that it is in view.
  var picks = document.querySelectorAll(".picker button");
  var picker = document.querySelector(".picker");
  // The page may lay the report out before showing it, or the phone may
  // turn: scroll again whenever the width changes.
  function toCurrent() {
    var current = document.querySelector('.picker button[aria-pressed="true"]');
    if (picker && current) {
      picker.scrollLeft = current.offsetLeft + current.offsetWidth - picker.clientWidth + 16;
    }
  }
  toCurrent();
  window.addEventListener("resize", toCurrent);
  picks.forEach(function (b) {
    b.addEventListener("click", function () {
      picks.forEach(function (o) { o.setAttribute("aria-pressed", String(o === b)); });
      document.querySelectorAll("section.month").forEach(function (m) { m.hidden = m.dataset.month !== b.dataset.month; });
    });
  });
  // A segment of the bar opens its line below.
  document.querySelectorAll(".bar .seg").forEach(function (seg) {
    seg.addEventListener("click", function () {
      var month = seg.closest("section.month");
      month.querySelectorAll("details.part").forEach(function (d) { d.open = d.dataset.part === seg.dataset.part; });
      month.querySelector('details.part[data-part="' + seg.dataset.part + '"]').scrollIntoView({ block: "nearest" });
    });
  });
  // Printing shows everything.
  window.addEventListener("beforeprint", function () {
    document.querySelectorAll("details").forEach(function (d) { d.open = true; });
  });
  // Inside the web app the report sits in a frame: tell it the height of
  // the content. Not the document's scroll height: that is never less than
  // the frame, so each resize of the frame would ask for a larger one.
  if (window.parent !== window) {
    // The page around it already shows the disclaimer and the version.
    document.documentElement.classList.add("embedded");
    var tell = function () { window.parent.postMessage({ cedoloHeight: document.body.getBoundingClientRect().height }, "*"); };
    window.addEventListener("load", tell);
    window.addEventListener("resize", tell);
    // Content can also change height later, as text reflows with a late font.
    if (window.ResizeObserver) new ResizeObserver(tell).observe(document.body);
  }
})();
</script>
</body>
</html>
{{define "line"}}<li><details><summary><span class="desc">{{.Description}}</span><span class="amount">{{.Amount}}</span></summary><p class="explain"><strong>{{.Label}}</strong> · {{.Text}}</p></details></li>{{end}}
