<!doctype html>
<html lang="{{.Lang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:; form-action 'none'; base-uri 'none'">
<meta name="referrer" content="no-referrer">
<meta name="robots" content="noindex">
<title>{{index .T "report.title"}}</title>
<style>
:root {
  color-scheme: light dark;
  --surface: #fcfcfb;
  --raised: #ffffff;
  --ink: #0b0b0b;
  --ink-2: #52514e;
  --muted: #898781;
  --grid: #e1e0d9;
  --baseline: #c3c2b7;
  --series-1: #2a78d6;
  --series-2: #eb6834;
  --series-3: #1baf7a;
  --series-4: #8a63d2;
  --good: #1a7f4e;
  --warn: #a35a00;
  --bad: #b3261e;
}
@media (prefers-color-scheme: dark) {
  :root:where(:not([data-theme="light"])) {
    --surface: #1a1a19;
    --raised: #222221;
    --ink: #f0efec;
    --ink-2: #c3c2b7;
    --muted: #898781;
    --grid: #2c2c2a;
    --baseline: #383835;
    --series-1: #3987e5;
    --series-2: #d95926;
    --series-3: #199e70;
    --series-4: #9b7be0;
    --good: #5cc48e;
    --warn: #e0a24a;
    --bad: #f08a80;
  }
}
:root[data-theme="dark"] {
  --surface: #1a1a19;
  --raised: #222221;
  --ink: #f0efec;
  --ink-2: #c3c2b7;
  --muted: #898781;
  --grid: #2c2c2a;
  --baseline: #383835;
  --series-1: #3987e5;
  --series-2: #d95926;
  --series-3: #199e70;
  --series-4: #9b7be0;
  --good: #5cc48e;
  --warn: #e0a24a;
  --bad: #f08a80;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--surface);
  color: var(--ink);
  font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
main { max-width: 760px; margin: 0 auto; padding: 32px 16px 48px; }
h1 { font-size: 28px; line-height: 1.2; margin: 0 0 4px; }
h2, h3 { font-size: 20px; margin: 40px 0 8px; }
h2.group { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 56px 0 0; padding-top: 16px; border-top: 1px solid var(--grid); }
h2.group + section > h3:first-child { margin-top: 16px; }
h2.total { display: flex; gap: 12px; align-items: baseline; }
h2.total span:first-child { flex: 1; }
h2.total .amount { font-variant-numeric: tabular-nums; }
.tabs { display: flex; gap: 4px; margin: 20px -16px 0; padding: 0 16px; border-bottom: 1px solid var(--grid); overflow-x: auto; scrollbar-width: none; position: sticky; top: 0; z-index: 1; background: var(--surface); }
.embedded .tabs { display: none; }
.panel:not([hidden]) { animation: panel-in .18s ease-out; }
@keyframes panel-in { from { opacity: 0; transform: translateX(var(--from, 0)); } }
@media (prefers-reduced-motion: reduce) { .panel:not([hidden]) { animation: none; } }
.when { display: flex; align-items: center; gap: 8px; }
.when .label { flex: 1; }
.steps { display: flex; gap: 6px; }
.fund { margin: 8px 0 0; padding: 10px 14px; border-radius: 8px; background: var(--raised); color: var(--ink-2); font-size: 15px; }
.leave { list-style: none; padding: 0; margin: 0; }
.leave li { display: grid; grid-template-columns: 1fr auto; gap: 2px 12px; padding: 10px 0; border-bottom: 1px solid var(--grid); }
.leave .left { font-weight: 600; font-variant-numeric: tabular-nums; }
.leave .moves { grid-column: 1 / -1; font-size: 14px; color: var(--ink-2); font-variant-numeric: tabular-nums; }
.steps button { width: 36px; height: 36px; border-radius: 999px; border: 1px solid var(--grid); background: var(--raised); color: var(--ink); font: inherit; font-size: 20px; line-height: 1; cursor: pointer; }
.steps button:disabled { opacity: .35; cursor: default; }
.tabs button { flex: none; font: inherit; font-size: 15px; font-weight: 600; padding: 10px 12px; margin-bottom: -1px; border: 0; border-bottom: 2px solid transparent; background: none; color: var(--ink-2); cursor: pointer; }
.tabs button[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--ink); }
.tabs button:focus-visible { outline: 2px solid var(--series-1); outline-offset: -2px; border-radius: 4px; }
.tabs ~ .panel h2.group { display: none; }
.tabs ~ .panel > section:first-of-type > h3 { margin-top: 24px; }
.link { font: inherit; font-size: 15px; padding: 0; border: 0; background: none; color: var(--series-1); cursor: pointer; text-align: left; }
.stat { margin: 0 0 8px; color: var(--ink-2); }
.stat strong { font-size: 28px; color: var(--ink); font-variant-numeric: tabular-nums; margin-right: 6px; }
.mini { max-width: 420px; }
.as-table { margin-top: 4px; }
p { margin: 0 0 12px; }
.sub, .note, small { color: var(--ink-2); }
.note { font-size: 14px; }
[hidden] { display: none !important; }
.picker { display: flex; gap: 6px; overflow-x: auto; margin: 20px -16px 0; padding: 2px 16px 6px; scrollbar-width: none; }
.picker button { flex: none; font: inherit; font-size: 14px; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--grid); background: var(--raised); color: var(--ink); cursor: pointer; }
.picker button[aria-pressed="true"] { background: var(--ink); color: var(--surface); border-color: var(--ink); }
.month { margin-top: 24px; }
.when { color: var(--ink-2); margin: 0; }
.when .status { font-size: 14px; margin-left: 8px; }
.net { margin: 4px 0 0; display: flex; flex-direction: column; }
.net .label { font-size: 14px; color: var(--ink-2); }
.net .big { font-size: 44px; line-height: 1.1; font-weight: 700; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
.summary { margin: 12px 0 0; font-size: 17px; max-width: 34em; }
.bar { display: flex; gap: 2px; height: 28px; margin: 12px 0 6px; }
.bar .seg { border: 0; padding: 0; min-width: 4px; cursor: pointer; }
.bar .seg:first-child { border-radius: 6px 0 0 6px; }
.bar .seg:last-child { border-radius: 0 6px 6px 0; }
.bar .seg:hover, .bar .seg:focus-visible { opacity: .8; }
.hint { font-size: 14px; color: var(--muted); margin: 0 0 8px; }
.part-net { --c: var(--series-1); } .part-contrib { --c: var(--series-2); } .part-taxes { --c: var(--series-3); } .part-other { --c: var(--series-4); }
.part-gross, .part-aside { --c: transparent; }
.bar .seg { background: var(--c); }
.parts { border-top: 1px solid var(--grid); }
.part { margin: 0; border-bottom: 1px solid var(--grid); }
.part > summary { display: flex; align-items: center; gap: 10px; padding: 12px 0; color: var(--ink); font-size: 16px; list-style: none; }
.part > summary::-webkit-details-marker { display: none; }
.part > summary .key { flex: none; width: 12px; height: 12px; border-radius: 3px; background: var(--c); border: 1px solid var(--c); }
.part > summary .name { flex: 1; }
.part > summary .amount { font-variant-numeric: tabular-nums; font-weight: 600; }
.part > summary::after { content: "›"; color: var(--muted); transition: transform .15s; }
.part[open] > summary::after { transform: rotate(90deg); }
.part .body { padding: 0 0 12px 22px; }
.explain { font-size: 15px; color: var(--ink-2); margin: 0 0 8px; max-width: 70ch; }
.lines { list-style: none; padding: 0; margin: 0; }
.lines details { margin: 0; }
.lines summary { display: flex; gap: 12px; padding: 6px 0; color: var(--ink); font-size: 15px; }
.lines summary .desc { flex: 1; }
.lines summary .amount { font-variant-numeric: tabular-nums; white-space: nowrap; }
.lines summary { list-style: none; cursor: pointer; }
.lines summary::-webkit-details-marker { display: none; }
.lines summary::after { content: "›"; color: var(--muted); width: 8px; transition: transform .15s; }
.lines details[open] summary::after { transform: rotate(90deg); }
.lines .explain { font-size: 14px; padding: 0 0 6px; }
figure { margin: 0; position: relative; }
.chart { width: 100%; height: auto; display: block; overflow: visible; }
.chart .grid { stroke: var(--grid); stroke-width: 1; }
.chart .baseline { stroke: var(--baseline); stroke-width: 1; }
.chart .tick { fill: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
.chart .end-label { fill: var(--ink-2); font-size: 12px; font-variant-numeric: tabular-nums; }
.chart .series-line { fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
.chart .dot { stroke: var(--surface); stroke-width: 2; }
.chart .crosshair { stroke: var(--baseline); stroke-width: 1; }
.chart .seg { outline: none; }
.chart .seg:hover, .chart .seg:focus { opacity: .8; }
.chart.stack .col-hit { cursor: pointer; }
/* A finger dragged sideways over a chart moves along it; up and down
   still scroll the page. */
.chart { touch-action: pan-y; -webkit-user-select: none; user-select: none; -webkit-tap-highlight-color: transparent; }
.chart .col { transition: opacity .15s; }
.chart .col.dim { opacity: .35; }
.chart .month.current { fill: var(--ink); font-weight: 600; }
.minis { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 8px 24px; margin-bottom: 12px; }
.mini figcaption { font-size: 14px; color: var(--ink-2); }
.mini figcaption strong { color: var(--ink); font-variant-numeric: tabular-nums; }
.legend { display: flex; flex-wrap: wrap; gap: 4px 16px; margin: 4px 0 8px; font-size: 14px; color: var(--ink-2); padding: 0; list-style: none; }
.legend .key { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: baseline; }
.legend .key.line { height: 2px; width: 14px; vertical-align: middle; border-radius: 1px; }
.tooltip {
  position: absolute; pointer-events: none; z-index: 1;
  background: var(--raised); color: var(--ink);
  border: 1px solid var(--grid); border-radius: 6px;
  padding: 6px 10px; font-size: 13px; white-space: nowrap;
  box-shadow: 0 2px 8px rgb(0 0 0 / .12);
}
.tooltip[hidden] { display: none; }
.tooltip .row { display: flex; align-items: center; gap: 6px; font-variant-numeric: tabular-nums; }
.tooltip .key { width: 8px; height: 8px; border-radius: 2px; }
.tooltip .head { color: var(--ink-2); }
.tooltip .total { font-weight: 600; }
/* On a touch screen the amounts stay under the chart, out from under the
   finger, until another column is touched. */
.tooltip.pinned { position: static; margin-top: 8px; box-shadow: none; pointer-events: auto; white-space: normal; font-size: 14px; }
.tooltip .open { margin-top: 6px; font-size: 14px; }
details { margin-top: 8px; }
summary { cursor: pointer; color: var(--ink-2); font-size: 14px; }
.scroll { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 14px; }
th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--grid); vertical-align: top; }
th { color: var(--ink-2); font-weight: 600; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
.status { white-space: nowrap; }
.status::before { display: inline-block; width: 1.2em; font-weight: 700; }
.status.verified { color: var(--good); }
.status.verified::before { content: "✓"; }
.status.unverified { color: var(--warn); }
.status.unverified::before { content: "~"; }
.status.inconsistent { color: var(--bad); }
.status.inconsistent::before { content: "!"; }
.changes { margin: 0; padding-left: 20px; }
.changes > li { padding: 4px 0; }
.changes .why, .month > .why { color: var(--ink-2); font-size: 14px; }
.month > .why { margin: 4px 0 0; max-width: 40em; }
.more-changes { margin-top: 4px; }
.more-changes > summary { font-size: 14px; color: var(--series-1); }
.contract-note { margin-top: 12px; }
.glossary { margin: 12px 0 0; }
.glossary dt { font-weight: 600; margin-top: 14px; }
.glossary dd { margin: 4px 0 0; font-size: 15px; color: var(--ink-2); max-width: 70ch; }
footer { margin-top: 32px; font-size: 13px; color: var(--muted); }
.embedded footer, .embedded h1 { display: none; }
.embedded header .sub { margin-top: 0; }
.embedded main { padding-top: 8px; padding-bottom: 8px; }
.chart.narrow { display: none; }
@media (max-width: 520px) {
  .chart.wide { display: none; }
  .chart.narrow { display: block; }
}
@media print {
  .tooltip, .picker, .hint, .tabs, .steps { display: none; }
  .panel[hidden] { display: block !important; }
  .tabs ~ .panel h2.group { display: block; }
  .month[hidden] { display: block !important; break-before: page; }
}
</style>
</head>
<body>
<main data-open="{{.OpenMonth}}">
<header>
<h1>{{index .T "report.title"}}</h1>
{{with .Range}}<p class="sub">{{.}}</p>{{end}}
</header>

{{if .Tabs}}
<div class="tabs" role="tablist" aria-label="{{index .T "report.tabs"}}">
<button type="button" role="tab" id="tab-month" data-tab="month" aria-controls="panel-month" aria-selected="true">{{index .T "report.tab.month"}}</button>
<button type="button" role="tab" id="tab-time" data-tab="time" aria-controls="panel-time" aria-selected="false" tabindex="-1">{{index .T "report.group.time"}}</button>
<button type="button" role="tab" id="tab-reference" data-tab="reference" aria-controls="panel-reference" aria-selected="false" tabindex="-1">{{index .T "report.group.reference"}}</button>
</div>
{{end}}

<div class="panel" id="panel-month"{{if .Tabs}} role="tabpanel" aria-labelledby="tab-month"{{end}}>
{{if gt (len .Months) 1}}
<nav class="picker" aria-label="{{index .T "report.pick"}}">
{{range $i, $m := .Months}}<button type="button" data-month="{{$i}}" aria-pressed="{{if eq $i $.Selected}}true{{else}}false{{end}}">{{$m.Short}}</button>
{{end}}</nav>
{{end}}

{{range $i, $m := .Months}}
<section class="month" data-month="{{$i}}"{{if ne $i $.Selected}} hidden{{end}}>
<p class="when"><span class="label">{{$m.Label}} <span class="status {{$m.Status}}">{{$m.StatusText}}</span></span>{{if gt (len $.Months) 1}}<span class="steps"><button type="button" data-to="{{$m.Prev}}" aria-label="{{index $.T "report.prev"}}"{{if not $m.Prev}} disabled{{end}}>‹</button><button type="button" data-to="{{$m.Next}}" aria-label="{{index $.T "report.next"}}"{{if not $m.Next}} disabled{{end}}>›</button></span>{{end}}</p>
<p class="net"><span class="label">{{index $.T "report.net"}}</span><span class="big">{{$m.Net}}</span></p>
{{if $m.Gross}}<p class="sub">{{$m.Gross}}</p>{{end}}
{{if $m.Summary}}<p class="summary">{{$m.Summary}}</p>{{end}}
{{range $m.SummaryWhy}}<p class="why">{{.}}</p>{{end}}
{{with $m.Reread}}<p class="note">{{.}}</p>{{end}}

{{if $m.Parts}}
<h2>{{index $.T "report.where"}}</h2>
<div class="bar">{{range $m.Parts}}<button type="button" class="seg part-{{.Key}}" style="width:{{printf "%.2f" .Width}}%" data-part="{{.Key}}" aria-label="{{.Label}} {{.Amount}}"></button>{{end}}</div>
<div class="parts">
{{range $m.Parts}}<details class="part part-{{.Key}}" data-part="{{.Key}}">
<summary><span class="key"></span><span class="name">{{.Label}}</span><span class="amount">{{.Amount}}</span></summary>
<div class="body"><p class="explain">{{.Text}}</p>
{{if .Lines}}<ul class="lines">{{range .Lines}}{{template "line" .}}{{end}}</ul>{{end}}</div>
</details>
{{end}}</div>
{{end}}

{{if $m.Earnings}}
<h2 class="total"><span>{{index $.T "report.earnings"}}</span><span class="amount">{{$m.GrossTotal}}</span></h2>
<ul class="lines">{{range $m.Earnings}}{{template "line" .}}{{end}}</ul>
{{end}}

{{if $m.SetAside}}
<h2 class="total"><span>{{index $.T "report.aside"}}</span><span class="amount">{{$m.AsideTotal}}</span></h2>
<p class="explain">{{index $.T "report.aside.text"}}</p>
<ul class="lines">{{range $m.SetAside}}{{template "line" .}}{{end}}</ul>
{{end}}
{{with $m.Fund}}<p class="fund">{{.}}</p>{{end}}

{{if $m.Leave}}
<h2>{{index $.T "report.leave"}}</h2>
<ul class="leave">
{{range $m.Leave}}<li><span class="name">{{.Label}}</span><span class="left">{{.Remaining}}</span>{{with .Moves}}<span class="moves">{{.}}</span>{{end}}</li>
{{end}}</ul>
{{end}}

{{if $m.Changes}}
<h2>{{index $.T "report.changes"}}</h2>
<ul class="changes">
{{range $m.Changes}}<li>{{.Text}}{{range .Why}}<div class="why">{{.}}</div>{{end}}</li>
{{end}}</ul>
{{if $m.More}}<details class="more-changes">
<summary>{{index $.T "report.all_changes"}} ({{len $m.More}})</summary>
<ul class="changes">
{{range $m.More}}<li>{{.Text}}{{range .Why}}<div class="why">{{.}}</div>{{end}}</li>
{{end}}</ul>
</details>{{end}}
{{end}}
</section>
{{end}}
</div>

<div class="panel" id="panel-time"{{if .Tabs}} role="tabpanel" aria-labelledby="tab-time" hidden{{end}}>
{{if or .Years .Trend .LeaveCharts .TFR}}
<h2 class="group">{{index .T "report.group.time"}}</h2>
{{end}}

{{with .Years}}
<section>
<h3>{{index $.T "report.years"}}</h3>
<div class="scroll">
<table class="years">
<thead><tr><th></th>{{range .Years}}<th class="num">{{.}}</th>{{end}}</tr></thead>
<tbody>
{{range .Rows}}<tr><th scope="row">{{.Label}}</th>{{range .Cells}}<td class="num">{{.}}</td>{{end}}</tr>
{{end}}</tbody>
</table>
</div>
<p class="note">{{index $.T "report.year.note"}}{{if .Partial}} {{index $.T "report.year.partial"}}{{end}}</p>
</section>
{{end}}

{{if .Trend}}
<section>
<h3>{{index .T "report.trend"}}</h3>
<ul class="legend">
<li><span class="key" style="background:var(--series-1)"></span>{{index .T "report.part.net"}}</li>
<li><span class="key" style="background:var(--series-2)"></span>{{index .T "report.part.contrib"}}</li>
<li><span class="key" style="background:var(--series-3)"></span>{{index .T "report.part.taxes"}}</li>
<li><span class="key" style="background:var(--series-4)"></span>{{index .T "report.part.other"}}</li>
</ul>
<figure>{{.Trend}}<div class="tooltip" hidden></div></figure>
<p class="hint">{{index .T "report.trend.tap"}}</p>
<details class="as-table">
<summary>{{index .T "report.table.show"}}</summary>
<div class="scroll">
<table>
<thead><tr>
<th>{{index .T "report.col.period"}}</th>
<th class="num">{{index .T "report.gross"}}</th>
<th class="num">{{index .T "report.contrib"}}</th>
<th class="num">{{index .T "report.taxes"}}</th>
<th class="num">{{index .T "report.deductions"}}</th>
<th class="num">{{index .T "report.net"}}</th>
<th>{{index .T "report.col.status"}}</th>
</tr></thead>
<tbody>
{{range .Rows}}<tr>
<td>{{.Period}}</td>
<td class="num">{{.Gross}}</td>
<td class="num">{{.Contributions}}</td>
<td class="num">{{.Taxes}}</td>
<td class="num">{{.Deductions}}</td>
<td class="num">{{.Net}}</td>
<td><span class="status {{.Status}}">{{.StatusText}}</span></td>
</tr>
{{end}}</tbody>
</table>
</div>
</details>
</section>
{{end}}

{{if .Variable}}
<section>
<h3>{{index .T "report.variable"}}</h3>
<figure>{{.Variable}}<div class="tooltip" hidden></div></figure>
</section>
{{end}}

{{if .LeaveCharts}}
<section>
<h3>{{index .T "report.leave.over"}}</h3>
<div class="minis">{{range .LeaveCharts}}<figure class="mini"><figcaption>{{.Label}} <strong>{{.Now}}</strong></figcaption>{{.SVG}}<div class="tooltip" hidden></div></figure>
{{end}}</div>
</section>
{{end}}

{{if .Fund}}
<section>
<h3>{{index .T "report.fund"}}</h3>
<p class="stat"><strong>{{.FundTotal}}</strong> {{.FundSpan}}</p>
<ul class="legend">
<li><span class="key" style="background:var(--series-1)"></span>{{index .T "report.fund.own"}}</li>
<li><span class="key" style="background:var(--series-2)"></span>{{index .T "report.fund.employer"}}</li>
<li><span class="key" style="background:var(--series-3)"></span>{{index .T "report.fund.tfr"}}</li>
</ul>
<figure>{{.Fund}}<div class="tooltip" hidden></div></figure>
<p class="note">{{index .T "report.fund.note"}}</p>
</section>
{{end}}

{{if .TFR}}
<section>
<h3>{{index .T "report.tfr"}}</h3>
<p class="stat"><strong>{{.TFRTotal}}</strong> {{.TFRSpan}}</p>
<div class="minis"><figure class="mini">{{.TFR}}<div class="tooltip" hidden></div></figure></div>
<p class="note">{{index .T "report.tfr.note"}}</p>
</section>
{{end}}

</div>

<div class="panel" id="panel-reference"{{if .Tabs}} role="tabpanel" aria-labelledby="tab-reference" hidden{{end}}>
{{if .Rows}}
<h2 class="group">{{index .T "report.group.reference"}}</h2>
<section>
<h3>{{index .T "glossary.terms"}}</h3>
<dl class="glossary">
{{range .Terms}}<dt>{{.Label}}</dt>
<dd>{{.Text}}</dd>
{{end}}</dl>
</section>
{{with .Contract}}<section>
<h3>{{index $.T "ccnl.section"}}</h3>
{{with .Title}}<p><strong>{{.}}</strong></p>{{end}}
{{with .Printed}}<p class="note">{{.}}</p>{{end}}
{{if .Rows}}<div class="scroll"><table>
<tbody>
{{range .Rows}}<tr><th scope="row">{{index . 0}}</th><td>{{index . 1}}</td></tr>
{{end}}</tbody>
</table></div>{{end}}
{{with .Note}}<p class="note contract-note">{{.}}</p>{{end}}
<p class="note">{{.Source}}</p>
</section>{{end}}
{{end}}
</div>

<footer>
<p>{{index .T "report.privacy"}}</p>
<p>{{index .T "report.disclaimer"}}</p>
<p>{{index .T "report.generated"}}{{with .Version}} {{.}}{{end}}</p>
</footer>
</main>
<script>
(function () {
  function place(tip, fig, x, y) {
    var w = fig.clientWidth, tw = tip.offsetWidth;
    tip.style.left = Math.max(0, Math.min(w - tw, x + 12)) + "px";
    tip.style.top = Math.max(0, y - tip.offsetHeight - 8) + "px";
  }
  function row(color, name, value) {
    var r = document.createElement("div"); r.className = "row";
    var k = document.createElement("span"); k.className = "key"; k.style.background = color;
    var t = document.createElement("span"); t.textContent = name + ": " + value;
    r.appendChild(k); r.appendChild(t); return r;
  }
  function head(text) {
    var h = document.createElement("div"); h.className = "head"; h.textContent = text; return h;
  }
  // A mouse shows the amounts beside the pointer while it is over a chart.
  // A finger would hide them, so a touch pins them under the chart instead,
  // and dragging sideways moves along the months. A touch shows them when
  // the finger lifts: not when it lands, which may start a scroll.
  var pointer = "mouse";
  document.addEventListener("pointerdown", function (ev) { pointer = ev.pointerType; }, true);
  function pinned(ev) { return ev.pointerType !== "mouse"; }
  // A finger dragged over a chart moves the amounts already shown.
  function drags(tip, ev) {
    return ev.pointerType === "mouse" || (ev.buttons && !tip.hidden && tip.classList.contains("pinned"));
  }
  function show(tip, fig, ev) {
    var pin = pinned(ev);
    tip.classList.toggle("pinned", pin);
    tip.hidden = false;
    if (pin) { tip.style.left = tip.style.top = ""; return; }
    var box = fig.getBoundingClientRect();
    place(tip, fig, ev.clientX - box.left, ev.clientY - box.top);
  }
  document.querySelectorAll("svg.chart.line").forEach(function (svg) {
    var fig = svg.parentNode, tip = fig.querySelector(".tooltip");
    var xs = svg.dataset.x.split(",").map(Number), pts = JSON.parse(svg.dataset.points);
    var cross = svg.querySelector(".crosshair"), hit = svg.querySelector(".hit");
    function move(ev) {
      var pt = svg.createSVGPoint(); pt.x = ev.clientX; pt.y = ev.clientY;
      var p = pt.matrixTransform(svg.getScreenCTM().inverse());
      var best = 0;
      xs.forEach(function (x, i) { if (Math.abs(x - p.x) < Math.abs(xs[best] - p.x)) best = i; });
      cross.setAttribute("x1", xs[best]); cross.setAttribute("x2", xs[best]);
      cross.setAttribute("visibility", "visible");
      tip.replaceChildren(head(pts[best].label));
      pts[best].values.forEach(function (v) { tip.appendChild(row(v.color, v.name, v.value)); });
      show(tip, fig, ev);
    }
    hit.addEventListener("pointerup", function (ev) { if (pinned(ev)) move(ev); });
    hit.addEventListener("pointermove", function (ev) { if (drags(tip, ev)) move(ev); });
    hit.addEventListener("pointerleave", function (ev) {
      if (ev.pointerType !== "mouse") return;
      tip.hidden = true; cross.setAttribute("visibility", "hidden");
    });
  });
  // The month picker shows one payslip at a time. It opens on the latest
  // month, at the end of the row: scroll the row so that it is in view.
  var picks = document.querySelectorAll(".picker button");
  var picker = document.querySelector(".picker");
  // The page may lay the report out before showing it, or the phone may
  // turn: scroll again when the width changes. Not on every resize: inside
  // the web app the frame grows or shrinks with each month shown, and the
  // row must not jump under the finger that picked one.
  function toCurrent() {
    var current = document.querySelector('.picker button[aria-pressed="true"]');
    if (picker && current) {
      picker.scrollLeft = current.offsetLeft + current.offsetWidth - picker.clientWidth + 16;
    }
  }
  toCurrent();
  if (picker && window.ResizeObserver) {
    // Called after layout, before the row is painted at its new width.
    var width = picker.clientWidth;
    new ResizeObserver(function () {
      if (picker.clientWidth !== width) { width = picker.clientWidth; toCurrent(); }
    }).observe(picker);
  }
  // A month picked at the edge of the row slides fully into view.
  function reveal(b) {
    var left = b.offsetLeft - 16, right = b.offsetLeft + b.offsetWidth + 16 - picker.clientWidth;
    var to = picker.scrollLeft < right ? right : picker.scrollLeft > left ? left : null;
    if (to !== null) picker.scrollTo({ left: to, behavior: "smooth" });
  }
  picks.forEach(function (b) {
    b.addEventListener("click", function () {
      picks.forEach(function (o) { o.setAttribute("aria-pressed", String(o === b)); });
      document.querySelectorAll("section.month").forEach(function (m) { m.hidden = m.dataset.month !== b.dataset.month; });
      reveal(b);
    });
  });
  // The columns of the trend follow the month shown: its label stands out,
  // a column tells its amounts under the pointer and opens its month.
  function mark(i) {
    document.querySelectorAll(".chart.stack .month, .chart.stack .col").forEach(function (e) {
      e.classList.toggle("current", e.dataset.i === String(i));
    });
  }
  var shown = document.querySelector("section.month:not([hidden])");
  if (shown) mark(shown.dataset.month);
  picks.forEach(function (b) { b.addEventListener("click", function () { mark(b.dataset.month); }); });
  // Bring the month shown to the top: inside the web app the page around
  // the frame scrolls, so ask it to.
  function toTop(el) {
    var y = el.getBoundingClientRect().top + window.scrollY - 16;
    if (window.parent !== window) window.parent.postMessage({ cedoloScroll: y }, "*");
    else window.scrollTo({ top: y, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
  }
  function toMonth() { toTop(document.querySelector(".picker")); }
  // Tabs: the month, the payslips over time, and the reference. Arrows
  // move between them; a link to a tab opens it and scrolls to the tabs.
  var embedded = window.parent !== window;
  var tabs = Array.prototype.slice.call(document.querySelectorAll('[role="tab"]'));
  var names = tabs.map(function (t) { return t.dataset.tab; });
  function current() {
    for (var i = 0; i < tabs.length; i++) if (tabs[i].getAttribute("aria-selected") === "true") return names[i];
    return "";
  }
  // Inside the web app the tabs are the page's, which stay in view: the
  // report tells it which tab it shows, unless the page asked for it.
  function showTab(name, fromPage) {
    if (names.indexOf(name) < 0) return;
    var from = names.indexOf(current()) < names.indexOf(name) ? "24px" : "-24px";
    if (embedded && !fromPage) window.parent.postMessage({ cedoloTab: name }, "*");
    tabs.forEach(function (t) {
      var on = t.dataset.tab === name;
      t.setAttribute("aria-selected", String(on));
      t.tabIndex = on ? 0 : -1;
      var panel = document.getElementById("panel-" + t.dataset.tab);
      if (on && panel.hidden) panel.style.setProperty("--from", from);
      panel.hidden = !on;
    });
    // The row of months was hidden with its tab: bring the marked one back
    // into view.
    if (name === "month") toCurrent();
  }
  tabs.forEach(function (t, i) {
    t.addEventListener("click", function () { showTab(t.dataset.tab); });
    t.addEventListener("keydown", function (ev) {
      var j = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[ev.key];
      if (j === undefined) return;
      ev.preventDefault();
      var next = tabs[(j + tabs.length) % tabs.length];
      showTab(next.dataset.tab);
      next.focus();
    });
  });
  // The top of a tab: under the page's tabs inside the web app, else the
  // report's own tabs, which stay at the top of the window.
  function toTab(name) { toTop(embedded ? document.getElementById("panel-" + name) : document.querySelector(".tabs")); }
  document.querySelectorAll('button[data-tab]:not([role="tab"])').forEach(function (b) {
    b.addEventListener("click", function () {
      showTab(b.dataset.tab);
      toTab(b.dataset.tab);
    });
  });
  // A sideways swipe moves to the next or previous tab, except on rows that
  // scroll sideways themselves and on charts, where it moves along the
  // months.
  if (tabs.length) {
    var sx = null, sy = 0, st = 0;
    document.addEventListener("touchstart", function (ev) {
      sx = null;
      if (ev.touches.length !== 1 || ev.target.closest(".picker, .scroll, .tabs, .chart")) return;
      sx = ev.touches[0].clientX; sy = ev.touches[0].clientY; st = Date.now();
    }, { passive: true });
    document.addEventListener("touchend", function (ev) {
      if (sx === null) return;
      var dx = ev.changedTouches[0].clientX - sx, dy = ev.changedTouches[0].clientY - sy;
      sx = null;
      if (Math.abs(dx) < 60 || Math.abs(dx) < 2 * Math.abs(dy) || Date.now() - st > 800) return;
      var next = names[names.indexOf(current()) + (dx < 0 ? 1 : -1)];
      if (next) { showTab(next); toTab(next); }
    }, { passive: true });
  }
  // The arrows beside a month step to the one before or after.
  document.querySelectorAll(".steps button").forEach(function (b) {
    b.addEventListener("click", function () {
      var to = document.querySelector('.picker button[data-month="' + b.dataset.to + '"]');
      if (to) to.click();
    });
  });
  // A column opens its month: at once with a mouse, which has already
  // shown its amounts; after a touch, from a button under the amounts.
  function openMonth(i) {
    var b = document.querySelector('.picker button[data-month="' + i + '"]');
    if (b) { if (tabs.length) showTab("month"); b.click(); toMonth(); }
  }
  var openLabel = document.querySelector("main").dataset.open || "%s";
  document.querySelectorAll("svg.chart.stack").forEach(function (svg) {
    var fig = svg.parentNode, tip = fig.querySelector(".tooltip");
    var pts = JSON.parse(svg.dataset.points);
    var cols = svg.querySelectorAll(".col");
    function select(i, ev) {
      var head1 = head(pts[i].label);
      var total = document.createElement("div"); total.className = "row total";
      total.textContent = pts[i].total.name + ": " + pts[i].total.value;
      tip.replaceChildren(head1, total);
      pts[i].values.forEach(function (v) { tip.appendChild(row(v.color, v.name, v.value)); });
      if (pinned(ev) && document.querySelector('.picker button[data-month="' + i + '"]')) {
        var open = document.createElement("button");
        open.type = "button"; open.className = "link open";
        open.textContent = openLabel.replace("%s", pts[i].label) + " ›";
        open.addEventListener("click", function () { openMonth(i); });
        tip.appendChild(open);
      }
      cols.forEach(function (c) { c.classList.toggle("dim", c.dataset.i !== String(i)); });
      show(tip, fig, ev);
    }
    svg.querySelectorAll(".col-hit").forEach(function (hit) {
      var i = Number(hit.dataset.i);
      hit.addEventListener("pointerdown", function (ev) {
        // A finger keeps the first column it touched: let the columns it
        // moves over take the pointer in turn.
        if (hit.hasPointerCapture(ev.pointerId)) hit.releasePointerCapture(ev.pointerId);
      });
      hit.addEventListener("pointermove", function (ev) { if (drags(tip, ev)) select(i, ev); });
      hit.addEventListener("pointerleave", function (ev) {
        if (ev.pointerType !== "mouse" || tip.classList.contains("pinned")) return;
        tip.hidden = true;
        cols.forEach(function (c) { c.classList.remove("dim"); });
      });
      hit.addEventListener("pointerup", function (ev) { if (pinned(ev)) select(i, ev); });
      hit.addEventListener("click", function () { if (pointer === "mouse") openMonth(i); });
    });
  });
  // A segment of the bar opens its line below.
  document.querySelectorAll(".bar .seg").forEach(function (seg) {
    seg.addEventListener("click", function () {
      var month = seg.closest("section.month");
      month.querySelectorAll("details.part").forEach(function (d) { d.open = d.dataset.part === seg.dataset.part; });
      month.querySelector('details.part[data-part="' + seg.dataset.part + '"]').scrollIntoView({ block: "nearest" });
    });
  });
  // Printing shows everything.
  window.addEventListener("beforeprint", function () {
    document.querySelectorAll("details").forEach(function (d) { d.open = true; });
  });
  // Inside the web app the report sits in a frame: tell it the height of
  // the content. Not the document's scroll height: that is never less than
  // the frame, so each resize of the frame would ask for a larger one.
  if (embedded) {
    // The page around it already shows the disclaimer, the version and,
    // when there are tabs, the tabs: it is told which there are, and asks
    // for one in turn.
    document.documentElement.classList.add("embedded");
    if (tabs.length) {
      var labels = tabs.map(function (t) { return t.textContent; });
      window.addEventListener("load", function () {
        window.parent.postMessage({ cedoloTabs: { names: names, labels: labels, current: current() } }, "*");
      });
    }
    window.addEventListener("message", function (ev) {
      if (ev.source === window.parent && ev.data && typeof ev.data.cedoloShowTab === "string") showTab(ev.data.cedoloShowTab, true);
    });
    var tell = function () { window.parent.postMessage({ cedoloHeight: document.body.getBoundingClientRect().height }, "*"); };
    window.addEventListener("load", tell);
    window.addEventListener("resize", tell);
    // Content can also change height later, as text reflows with a late font.
    if (window.ResizeObserver) new ResizeObserver(tell).observe(document.body);
  }
})();
</script>
</body>
</html>
{{define "line"}}<li><details><summary><span class="desc">{{.Description}}</span><span class="amount">{{.Amount}}</span></summary><p class="explain"><strong>{{.Label}}</strong> · {{.Text}}</p></details></li>{{end}}
